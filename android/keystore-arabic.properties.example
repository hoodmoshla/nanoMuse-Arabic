// This is an EXAMPLE. Copy it to android/keystore-arabic.properties (git-ignored)
// and fill in the real values there — never commit the real file, and never paste
// the real values into an issue, a chat or a log.
//
// This file holds the key of the STANDALONE ARABIC EDITION only. It is read by
// android/src/android/app/build.gradle.kts, which looks for a properties file in
// this order (first one that exists wins):
//
//   1. the path in the $NM_KEYSTORE_PROPERTIES environment variable
//   2. android/keystore-arabic.properties   <- this file
//   3. android/keystore.properties          <- upstream's, untouched
//
// Create the key once, then keep two backups of the .jks somewhere safe: losing
// it means no future release of this edition can update an installed one.
//
//   keytool -genkeypair -v \
//     -keystore /absolute/path/to/nanomuse-arabic-release.jks \
//     -alias nanomuse-arabic \
//     -keyalg RSA -keysize 4096 -validity 10000 \
//     -storetype PKCS12
//
// Then print its fingerprint and keep it next to the backup:
//
//   keytool -list -v -keystore /absolute/path/to/nanomuse-arabic-release.jks \
//     -alias nanomuse-arabic | grep -E "SHA256|SHA-256"

// Path to the .jks. Use an ABSOLUTE path: a relative one is resolved against
// android/src/android/app/, not against this file's directory.
storeFile=/absolute/path/to/nanomuse-arabic-release.jks
storePassword=
keyAlias=nanomuse-arabic
keyPassword=
